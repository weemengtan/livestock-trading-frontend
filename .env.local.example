# Copy to .env.local for local dev.
# On Vercel: the Railway API's public https:// origin, no trailing slash.
# Baked in at BUILD time (also feeds the CSP connect-src) — changing it in
# Vercel requires a redeploy.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Web Push (§10). Must match backend's VAPID_PUBLIC_KEY
# (uv run python -m scripts.generate_vapid_keys). Left blank, the buyer
# PWA simply never subscribes to push — WS + polling still work.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# §16 — Sentry (components/sentry-init.tsx). Left blank, the SDK is never
# even imported. In production, point this at a self-hosted, FOSS-licensed
# target only (self-hosted Sentry, or GlitchTip) — never sentry.io.
NEXT_PUBLIC_SENTRY_DSN=
